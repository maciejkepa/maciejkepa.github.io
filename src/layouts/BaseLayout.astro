---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { siteConfig } from '../lib/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  image?: string;
  imageAlt?: string;
  keywords?: string[];
  author?: string;
  publishedTime?: string;
  modifiedTime?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description = siteConfig.description,
  ogType = 'website',
  image,
  imageAlt,
  keywords = [],
  author = siteConfig.owner,
  publishedTime,
  modifiedTime,
  structuredData
} = Astro.props;
const pageTitle = title ? `${title} | ${siteConfig.owner}` : `${siteConfig.owner} | ${siteConfig.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const defaultSocialImage = '/og-image.png';
const socialImagePath = image && !image.endsWith('.svg') ? image : defaultSocialImage;
const ogImage = new URL(socialImagePath, Astro.site);
const ogImageType = socialImagePath.endsWith('.png') ? 'image/png' : undefined;
const ogImageWidth = socialImagePath === defaultSocialImage ? '1200' : undefined;
const ogImageHeight = socialImagePath === defaultSocialImage ? '630' : undefined;
const structuredDataItems = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];
const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteConfig.url}/#website`,
      url: siteConfig.url,
      name: siteConfig.owner,
      alternateName: siteConfig.name,
      description: siteConfig.description,
      inLanguage: 'en'
    },
    {
      '@type': 'Person',
      '@id': `${siteConfig.url}/#person`,
      name: siteConfig.owner,
      url: siteConfig.url,
      jobTitle: siteConfig.role,
      worksFor: {
        '@type': 'Organization',
        name: 'Datumo',
        url: siteConfig.links.company
      },
      sameAs: [
        siteConfig.links.github,
        siteConfig.links.linkedin,
        siteConfig.links.sessionize
      ]
    },
    ...structuredDataItems
  ]
};
const themeBootstrap = `
(() => {
  const storageKey = 'maciejkepa-theme';
  const themeMeta = document.querySelector('meta[name="theme-color"]');
  const darkThemeColor = '#171511';
  const lightThemeColor = '#f1ede4';
  const stored = localStorage.getItem(storageKey);
  const theme = stored === 'light' || stored === 'dark' ? stored : 'light';
  document.documentElement.dataset.theme = theme;
  if (themeMeta) {
    themeMeta.setAttribute('content', theme === 'light' ? lightThemeColor : darkThemeColor);
  }
})();
`;
const themeController = `
(() => {
  const storageKey = 'maciejkepa-theme';
  const root = document.documentElement;
  const toggle = document.querySelector('[data-theme-toggle]');
  const themeMeta = document.querySelector('meta[name="theme-color"]');
  const darkThemeColor = '#171511';
  const lightThemeColor = '#f1ede4';

  if (!toggle) {
    return;
  }

  const syncUi = (theme) => {
    root.dataset.theme = theme;
    toggle.setAttribute('aria-label', theme === 'light' ? 'Light theme. Switch to dark theme.' : 'Dark theme. Switch to light theme.');
    toggle.setAttribute('title', theme === 'light' ? 'Switch to dark theme' : 'Switch to light theme');
    if (themeMeta) {
      themeMeta.setAttribute('content', theme === 'light' ? lightThemeColor : darkThemeColor);
    }
  };

  const getResolvedTheme = () => {
    const stored = localStorage.getItem(storageKey);
    if (stored === 'light' || stored === 'dark') {
      return stored;
    }

    return 'light';
  };

  syncUi(getResolvedTheme());

  toggle.addEventListener('click', () => {
    const nextTheme = root.dataset.theme === 'light' ? 'dark' : 'light';
    localStorage.setItem(storageKey, nextTheme);
    syncUi(nextTheme);
  });
})();
`;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" sizes="any" type="image/svg+xml" />
    <link rel="shortcut icon" href="/favicon.svg" />
    <meta name="theme-color" content="#f1ede4" />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <meta name="author" content={author} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {ogImageType && <meta property="og:image:type" content={ogImageType} />}
    {ogImageWidth && <meta property="og:image:width" content={ogImageWidth} />}
    {ogImageHeight && <meta property="og:image:height" content={ogImageHeight} />}
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === 'article' && <meta property="article:author" content={author} />}
    {ogType === 'article' &&
      keywords.map((keyword) => <meta property="article:tag" content={keyword} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    <script is:inline set:html={themeBootstrap} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
  </head>
  <body>
    <div class="site-shell">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <script is:inline set:html={themeController} />
  </body>
</html>
