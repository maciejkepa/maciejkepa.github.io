---
import BaseLayout from './BaseLayout.astro';
import LinkedInIcon from '../components/LinkedInIcon.astro';
import { formatDate } from '../lib/blog';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  seoTitle?: string;
  description: string;
  date: Date;
  updated?: Date;
  tags: string[];
  type: 'article' | 'guide';
  readingTime: number;
  headings: Heading[];
  repoUrl?: string;
  coverImage?: string;
  coverAlt?: string;
  faqs?: Array<{
    question: string;
    answer: string;
  }>;
}

const { title, seoTitle, description, date, updated, tags, type, readingTime, headings, repoUrl, coverImage, coverAlt, faqs = [] } = Astro.props;
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const publishedLabel = formatDate(date);
const updatedLabel = formatDate(updated ?? date);
const articleSchema = {
  '@type': 'BlogPosting',
  '@id': `${Astro.url.href}#article`,
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  author: {
    '@id': 'https://maciejkepa.dev/#person'
  },
  publisher: {
    '@id': 'https://maciejkepa.dev/#person'
  },
  mainEntityOfPage: Astro.url.href,
  keywords: tags,
  articleSection: type === 'guide' ? 'Technical guide' : 'Article',
  timeRequired: `PT${readingTime}M`,
  image: coverImage ? [new URL(coverImage, Astro.site).href] : undefined
};
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  '@id': `${Astro.url.href}#breadcrumb`,
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', Astro.site).href
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: new URL('/blog/', Astro.site).href
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: title,
      item: Astro.url.href
    }
  ]
};
const faqSchema = faqs.length > 0
  ? {
      '@type': 'FAQPage',
      '@id': `${Astro.url.href}#faq`,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer
        }
      }))
    }
  : undefined;
const lightboxController = `
(() => {
  const article = document.querySelector('.article-body');
  const lightbox = document.querySelector('[data-image-lightbox]');
  const lightboxImage = lightbox?.querySelector('[data-lightbox-image]');
  const lightboxCaption = lightbox?.querySelector('[data-lightbox-caption]');
  const closeControls = lightbox?.querySelectorAll('[data-lightbox-close]');

  if (!article || !lightbox || !lightboxImage || !lightboxCaption) {
    return;
  }

  const close = () => {
    lightbox.hidden = true;
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.style.removeProperty('overflow');
    lightboxImage.removeAttribute('src');
    lightboxImage.removeAttribute('alt');
    lightboxCaption.textContent = '';
    lightboxCaption.hidden = true;
  };

  const open = (image) => {
    const figure = image.closest('figure');
    const caption = figure?.querySelector('figcaption')?.textContent?.trim() ?? '';
    const source = image.currentSrc || image.getAttribute('src');

    if (!source) {
      return;
    }

    lightboxImage.setAttribute('src', source);
    lightboxImage.setAttribute('alt', image.getAttribute('alt') ?? '');
    lightboxCaption.textContent = caption;
    lightboxCaption.hidden = caption.length === 0;
    lightbox.hidden = false;
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  };

  article.addEventListener('click', (event) => {
    const image = event.target.closest('img');

    if (!image || !article.contains(image) || image.closest('.article-author')) {
      return;
    }

    event.preventDefault();
    open(image);
  });

  closeControls?.forEach((control) => {
    control.addEventListener('click', close);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !lightbox.hidden) {
      close();
    }
  });
})();
`;
---

<BaseLayout
  title={title}
  seoTitle={seoTitle}
  description={description}
  ogType="article"
  image={coverImage}
  imageAlt={coverAlt}
  keywords={tags}
  publishedTime={date.toISOString()}
  modifiedTime={(updated ?? date).toISOString()}
  structuredData={faqSchema ? [articleSchema, breadcrumbSchema, faqSchema] : [articleSchema, breadcrumbSchema]}
>
  <section class="article-hero">
    <div class="container narrow">
      <span class="eyebrow">{type}</span>
      <h1 class="section-title">{title}</h1>
      <p class="section-copy">{description}</p>

      <div class="article-hero__meta">
        <span>Published: {publishedLabel}</span>
        <span>Updated: {updatedLabel}</span>
        <span>{readingTime} min read</span>
        {repoUrl && (
          <a href={repoUrl} target="_blank" rel="noreferrer">Companion repository</a>
        )}
      </div>

      <div class="pill-row" aria-label="Article tags">
        {tags.map((tag) => (
          <span class="pill">{tag}</span>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="container article-layout">
      <article class="article-body prose">
        <slot />
        <footer class="article-author" aria-label="Author profile">
          <div>
            <span class="eyebrow">Author</span>
            <h2>Maciej Kępa</h2>
            <p>
              Data & AI Architect and Senior Data Engineer working on production data platforms, Azure, Databricks,
              MLOps foundations and ML observability for systems that need to be operated after the first model works.
            </p>
            <div class="article-author__follow">
              <a class="button" href="https://www.linkedin.com/in/maciej-kepa/" target="_blank" rel="noreferrer" aria-label="Follow Maciej Kępa on LinkedIn">
                <LinkedInIcon />
                Follow me
              </a>
            </div>
            <div class="article-author__links">
              <a href="/about/">About</a>
              <a href="/speaking/">Speaking</a>
              <a href="https://sessionize.com/maciej-kepa/" target="_blank" rel="noreferrer">Sessionize</a>
            </div>
          </div>
          <figure class="article-author__photo">
            <picture>
              <source
                type="image/webp"
                srcset="/images/maciej-kepa-about-480.webp 480w, /images/maciej-kepa-about-960.webp 960w"
                sizes="4.5rem"
              />
              <img src="/images/maciej-kepa-about.jpg" alt="Maciej Kępa" width="4000" height="6000" loading="lazy" decoding="async" />
            </picture>
          </figure>
          <dl class="article-author__meta">
            <div>
              <dt>Published</dt>
              <dd>{publishedLabel}</dd>
            </div>
            <div>
              <dt>Updated</dt>
              <dd>{updatedLabel}</dd>
            </div>
          </dl>
        </footer>
      </article>

      {tocHeadings.length > 0 && (
        <aside class="toc" aria-label="Table of contents">
          <h2>Contents</h2>
          <ul>
            {tocHeadings.map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )}
    </div>
  </section>

  <div class="image-lightbox" data-image-lightbox hidden aria-hidden="true">
    <div class="image-lightbox__backdrop" data-lightbox-close></div>
    <figure class="image-lightbox__figure">
      <button class="image-lightbox__close" type="button" aria-label="Close enlarged image" data-lightbox-close>
        ×
      </button>
      <div class="image-lightbox__frame">
        <img class="image-lightbox__image" data-lightbox-image alt="" />
      </div>
      <figcaption class="image-lightbox__caption" data-lightbox-caption hidden></figcaption>
    </figure>
  </div>

  <script is:inline set:html={lightboxController} />
</BaseLayout>
