---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../lib/blog';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  tags: string[];
  type: 'article' | 'guide';
  readingTime: number;
  headings: Heading[];
  repoUrl?: string;
  coverImage?: string;
  coverAlt?: string;
  faqs?: Array<{
    question: string;
    answer: string;
  }>;
}

const { title, description, date, updated, tags, type, readingTime, headings, repoUrl, coverImage, coverAlt, faqs = [] } = Astro.props;
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const articleSchema = {
  '@type': 'BlogPosting',
  '@id': `${Astro.url.href}#article`,
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  author: {
    '@id': 'https://maciejkepa.dev/#person'
  },
  publisher: {
    '@id': 'https://maciejkepa.dev/#person'
  },
  mainEntityOfPage: Astro.url.href,
  keywords: tags,
  articleSection: type === 'guide' ? 'Technical guide' : 'Article',
  timeRequired: `PT${readingTime}M`,
  image: coverImage ? [new URL(coverImage, Astro.site).href] : undefined
};
const faqSchema = faqs.length > 0
  ? {
      '@type': 'FAQPage',
      '@id': `${Astro.url.href}#faq`,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer
        }
      }))
    }
  : undefined;
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  image={coverImage}
  imageAlt={coverAlt}
  keywords={tags}
  publishedTime={date.toISOString()}
  modifiedTime={(updated ?? date).toISOString()}
  structuredData={faqSchema ? [articleSchema, faqSchema] : articleSchema}
>
  <section class="article-hero">
    <div class="container narrow">
      <span class="eyebrow">{type}</span>
      <h1 class="section-title">{title}</h1>
      <p class="section-copy">{description}</p>

      <div class="article-hero__meta">
        <span>Published: {formatDate(date)}</span>
        <span>Updated: {formatDate(updated ?? date)}</span>
        <span>{readingTime} min read</span>
        {repoUrl && (
          <a href={repoUrl} target="_blank" rel="noreferrer">Companion repository</a>
        )}
      </div>

      <div class="pill-row" aria-label="Article tags">
        {tags.map((tag) => (
          <span class="pill">{tag}</span>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="container article-layout">
      <article class="article-body prose">
        <slot />
      </article>

      {tocHeadings.length > 0 && (
        <aside class="toc" aria-label="Table of contents">
          <h2>Contents</h2>
          <ul>
            {tocHeadings.map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )}
    </div>
  </section>
</BaseLayout>
