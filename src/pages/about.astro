---
import BaseLayout from '../layouts/BaseLayout.astro';
import LinkedInIcon from '../components/LinkedInIcon.astro';
import { principles, siteConfig, speakingSessions } from '../lib/site';

const operatingSpace = [
  'Azure-native data platforms and delivery systems',
  'Databricks, lakehouse patterns and analytics-ready architecture',
  'MLOps foundations for repeatable delivery and model operations',
  'Data engineering connected to production ML and AI systems'
];

const focusAreas = [
  {
    title: 'Data Platforms',
    copy: 'Designing Azure- and Databricks-based platforms that make analytics and AI delivery operational, not improvised.'
  },
  {
    title: 'MLOps Systems',
    copy: 'Building model lifecycle foundations, delivery workflows, observability and reliability around production ML.'
  },
  {
    title: 'AI in Production',
    copy: 'Treating model quality and platform quality as the same engineering problem, especially in edge, IoT and data-centric workloads.'
  }
];

const beyondWork = [
  'Animal lover with a soft spot for real-world chaos over perfect lab conditions.',
  'Gaming enthusiast, especially where systems, strategy and immersion matter.',
  'DIY hobbyist who likes building, fixing and understanding things end to end.'
];

const portrait = '/images/maciej-kepa-about.jpg';
const selectedTalks = speakingSessions.filter((talk) => ['aiba-2025-mlops', 'sqlday-2025-observability', 'sqlday-2026-workshop'].includes(talk.id));
const profileSchema = {
  '@type': 'ProfilePage',
  '@id': `${siteConfig.url}/about/#profile`,
  url: `${siteConfig.url}/about/`,
  name: `About ${siteConfig.owner} - ${siteConfig.role}`,
  mainEntity: { '@id': `${siteConfig.url}/#person` }
};
---

<BaseLayout seoTitle="About Maciej Kępa - Data & AI Architect" description="Maciej Kępa, Data & AI Architect at Datumo in Kraków, Poland. MLOps, AI-ready data platforms, Azure, Databricks and practical conference sessions." structuredData={profileSchema}>
  <section class="section">
    <div class="container about-hero surface">
      <div class="about-hero__content">
        <span class="eyebrow">About</span>
        <h1 class="section-title">Maciej Kępa - {siteConfig.role}</h1>
        <p class="section-copy">
          I’m Maciej Kępa, a Data & AI Architect at <a href={siteConfig.links.company} target="_blank" rel="noreferrer">Datumo</a>, based in {siteConfig.location}. I work on MLOps and data platforms, primarily with Azure and Databricks, focusing on how teams deploy, monitor and maintain data and ML systems.
        </p>
        <p class="section-copy">
          My work centers on making AI useful in real environments: platform architecture, repeatable delivery, MLOps foundations, observability and the engineering boundaries between data systems and machine learning systems.
        </p>
        <div class="pill-row" aria-label="Operating space">
          {operatingSpace.map((item) => (
            <span class="pill">{item}</span>
          ))}
        </div>
        <p class="section-copy">
          I care about systems that are scalable, observable, maintainable and actually ready for production, not only persuasive in a workshop or notebook demo.
        </p>
        <div class="button-row">
          <a class="button" href={siteConfig.links.linkedin} target="_blank" rel="noreferrer" aria-label="Follow Maciej Kępa on LinkedIn">
            <LinkedInIcon />
            Contact me on LinkedIn
          </a>
          <a class="button button--secondary" href={siteConfig.links.sessionize} target="_blank" rel="noreferrer">Sessionize</a>
        </div>
      </div>

      <figure class="about-hero__photo">
        <picture>
          <source
            type="image/webp"
            srcset="/images/maciej-kepa-about-480.webp 480w, /images/maciej-kepa-about-960.webp 960w"
            sizes="(min-width: 64rem) 32vw, 100vw"
          />
          <img src={portrait} alt="Portrait of Maciej Kępa" width="4000" height="6000" loading="eager" fetchpriority="high" decoding="async" />
        </picture>
      </figure>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container about-section surface">
      <div class="about-section__intro">
        <span class="eyebrow">Speaking and community</span>
        <h2 class="section-title section-title--compact">Sharing the work</h2>
        <p class="section-copy">I am a member of Data Community Poland and part of the SQLDay organizing team. My talks and workshops connect architecture decisions to operating data and ML systems.</p>
        <div class="button-row">
          <a class="button" href="/speaking/">Talks and speaking invitations</a>
          <a class="button button--secondary" href="/projects/">Explore public projects</a>
        </div>
      </div>
      <div class="about-section__body about-entry-list">
        {selectedTalks.map((talk) => (
          <article class="about-entry">
            <span class="kicker">{talk.event} {talk.year} · {talk.format}</span>
            <h3 class="card__title"><a href={`/speaking/#${talk.id}`}>{talk.title}</a></h3>
            <p>{talk.focus}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container about-section surface">
      <div class="about-section__intro">
        <span class="eyebrow">What I build</span>
        <h2 class="section-title" style="font-size: clamp(2rem, 4vw, 2.9rem);">Three recurring problem spaces</h2>
        <p class="section-copy">The common thread is operational reality: architecture, delivery and platform quality need to hold together under production constraints.</p>
      </div>
      <div class="about-section__body about-entry-list">
        {focusAreas.map((area) => (
          <article class="about-entry">
            <h3 class="card__title">{area.title}</h3>
            <p>{area.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container about-section surface">
      <div class="about-section__intro">
        <span class="eyebrow">Principles</span>
        <h2 class="section-title" style="font-size: clamp(2rem, 4vw, 2.9rem);">How I tend to reason about systems</h2>
      </div>
      <div class="about-section__body about-principles">
        {principles.map((principle, index) => (
          <div class="about-principle">
            <span class="about-principle__index">0{index + 1}</span>
            <p>{principle}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container about-section surface">
      <div class="about-section__intro">
        <span class="eyebrow">Beyond work</span>
        <h2 class="section-title" style="font-size: clamp(2rem, 4vw, 2.9rem);">Interests that map well to engineering</h2>
      </div>
      <div class="about-section__body about-notes">
        {beyondWork.map((item) => (
          <p>{item}</p>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
