---
import { getCollection } from 'astro:content';

import ArticleCard from '../../../components/ArticleCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPostFilterTokens, getTopicCards, sortPosts } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection('blog', ({ data }) => !data.draft));
  const activeTopics = getTopicCards(posts);

  return activeTopics.map((topic) => ({
    params: { topic: topic.slug },
    props: { activeTopic: topic.slug, activeLabel: topic.label }
  }));
}

const { activeTopic, activeLabel } = Astro.props;
const allPosts = sortPosts(await getCollection('blog', ({ data }) => !data.draft));
const posts = allPosts.filter((post) => getPostFilterTokens(post).includes(activeTopic));
const filters = [{ label: 'All', slug: 'all' }, ...getTopicCards(allPosts)];
const topicHubCopy: Record<string, { title: string; description: string; intro: string[] }> = {
  mlops: {
    title: 'Production MLOps guides and operating models',
    description: 'MLOps writing on delivery patterns, model operations, observability, governance and the engineering foundations behind production ML systems.',
    intro: [
      'This topic collects production-first MLOps writing: delivery patterns, model release decisions, observability evidence, ownership boundaries and the operating practices that make ML systems maintainable.',
      'The focus is practical rather than tool-first. Start here when the question is how to move from experiments to repeatable, observable and governed production workflows, with enough context to explain what happened after a release.'
    ]
  },
  databricks: {
    title: 'Databricks MLOps, data engineering and AI platform patterns',
    description: 'Databricks guides for production ML delivery, GitHub Actions, MLflow, feature stores, lakehouse architecture and operational AI systems.',
    intro: [
      'This topic groups Databricks articles around production delivery: MLOps workflows, GitHub Actions, MLflow, feature engineering and lakehouse-side platform decisions.',
      'Use it as a reading path for teams that already have data gravity in Databricks and need stronger deployment, validation and operating boundaries.'
    ]
  },
  observability: {
    title: 'ML observability guides for production systems',
    description: 'ML observability articles on monitoring model behavior, data quality, prediction drift, feedback loops and operational signals.',
    intro: [
      'This topic focuses on ML observability: the signals and evidence that tell a team whether a model service, its inputs and its outputs are still trustworthy in production.',
      'The articles connect releases, data, runtime behavior and outcomes to actionable monitoring, ownership and incident response rather than dashboards that only look complete.'
    ]
  }
};
const topicCopy = topicHubCopy[activeTopic] ?? {
  title: `${activeLabel} articles and guides`,
  description: `Articles and guides about ${activeLabel} in production data and AI systems.`,
  intro: [
    `This topic collects articles and guides about ${activeLabel}, with a practical focus on production data, AI and ML engineering systems.`
  ]
};
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  '@id': `${Astro.url.href}#breadcrumb`,
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', Astro.site).href
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: new URL('/blog/', Astro.site).href
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: activeLabel,
      item: Astro.url.href
    }
  ]
};
---

<BaseLayout title={activeLabel} seoTitle={`${topicCopy.title} | Maciej Kępa`} description={topicCopy.description} structuredData={breadcrumbSchema}>
  <section class="section">
    <div class="container">
      <span class="eyebrow">Blog</span>
      <h1 class="section-title">{topicCopy.title}</h1>
      {topicCopy.intro.map((paragraph) => (
        <p class="section-copy">{paragraph}</p>
      ))}

      <div class="filter-row" aria-label="Blog topic filters">
        {filters.map((filter) => (
          <a
            class="filter-chip"
            href={filter.slug === 'all' ? '/blog/' : `/blog/topic/${filter.slug}/`}
            data-active={filter.slug === activeTopic}
            aria-current={filter.slug === activeTopic ? 'page' : undefined}
          >
            {filter.label}
          </a>
        ))}
      </div>

      <div class="post-list">
        {posts.map((post) => (
          <ArticleCard post={post} filterTokens={getPostFilterTokens(post)} layout="stack" />
        ))}
      </div>

      {posts.length === 0 && <p class="empty-state">No posts match the selected topic.</p>}
    </div>
  </section>
</BaseLayout>
