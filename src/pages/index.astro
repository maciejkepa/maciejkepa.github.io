---
import { getCollection } from 'astro:content';

import ArticleCard from '../components/ArticleCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPostFilterTokens, getTopicCards, sortPosts } from '../lib/blog';
import { getResponsiveCoverSources } from '../lib/images';
import { getReadingTime } from '../lib/reading-time';
import { siteConfig, speakingSessions } from '../lib/site';

const posts = sortPosts(await getCollection('blog', ({ data }) => !data.draft));
const topicCards = getTopicCards(posts);
const featuredSpeakingSessions = [...speakingSessions]
  .filter((session) => typeof session.featuredRank === 'number')
  .sort((a, b) => b.sortDate.localeCompare(a.sortDate))
  .slice(0, 2);
const primaryPost =
  posts.find((post) => post.data.featured) ??
  posts[0];
const supportingPosts = posts
  .filter((post) => post.id !== primaryPost?.id)
  .slice(0, 2);
const primaryCoverImage = primaryPost?.data.coverImage ?? '/blog-covers/default.svg';
const primaryCoverAlt = primaryPost?.data.coverAlt ?? `${primaryPost?.data.title ?? 'Featured article'} cover`;
const primaryCoverSources = getResponsiveCoverSources(primaryCoverImage);
const topicPaths = [
  {
    title: 'Production MLOps',
    topic: topicCards.find((topic) => topic.slug === 'mlops'),
    promise: 'From model packaging to deployment, ownership and operational readiness.',
    cta: 'Explore MLOps'
  },
  {
    title: 'AI Platform Architecture',
    topic: topicCards.find((topic) => topic.slug === 'ai-architecture'),
    promise: 'Reference architectures, trade-offs and platform decisions for production AI.',
    cta: 'Explore architecture'
  },
  {
    title: 'ML Observability',
    topic: topicCards.find((topic) => topic.slug === 'observability'),
    promise: 'Monitoring signals, feedback loops and operational baselines.',
    cta: 'Explore observability'
  }
].filter((path): path is typeof path & { topic: NonNullable<typeof path.topic> } => path.topic !== undefined);
const portrait = '/images/maciej-kepa-about.jpg';
const rssHighlights = ['Full articles and guides', 'Direct feed access from day one', 'No signup flow or newsletter gate'];
---

<BaseLayout>
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <span class="eyebrow">{siteConfig.name}</span>
        <h1 class="hero__title">{siteConfig.owner}</h1>
        <p class="hero__role">Data & AI Architect</p>
        <p class="hero__copy">
          I write about building data and AI systems that survive production — MLOps, observability, platform engineering and architecture.
        </p>

        <div class="hero__actions">
          <a class="button" href="/blog/">Read the blog</a>
          <a class="button button--secondary" href="/speaking/">Speaking</a>
          <a class="button button--secondary" href={siteConfig.links.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
          <a class="button button--secondary" href={siteConfig.links.github} target="_blank" rel="noreferrer">GitHub</a>
        </div>
      </div>

      <div class="hero-side hero-side--graphic">
        <div class="home-panel home-panel--center surface">
          <span class="eyebrow">Current focus</span>
          <h2 class="home-panel__title">Production over demos</h2>
          <p class="home-panel__copy">
            Practical notes on operating AI systems under real production constraints.
          </p>
        </div>

        <div class="metric-row">
          <div class="metric surface">
            <div class="metric__label">Platforms</div>
            <div class="metric__value">
              <span>Azure</span>
              <span>Databricks</span>
            </div>
          </div>
          <div class="metric surface">
            <div class="metric__label">Topics</div>
            <div class="metric__value">
              <span>AI</span>
              <span>Data</span>
              <span>MLOps</span>
            </div>
          </div>
          <div class="metric surface">
            <div class="metric__label">Public work</div>
            <div class="metric__value">
              <span>Articles</span>
              <span>Conference talks</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <span class="eyebrow">Featured writing</span>
      <h2 class="section-title">Long-form notes for engineers who have to ship</h2>
      <p class="section-copy">
        Architecture essays, delivery guides and operational lessons from the part of AI work that starts after the first promising notebook.
      </p>

      {primaryPost ? (
        <div class="featured-writing-layout">
          <article class="featured-post">
            <a class="featured-post__media" href={`/blog/${primaryPost.id}/`} aria-label={`Read ${primaryPost.data.title}`}>
              <picture>
                {primaryCoverSources && (
                  <source type="image/webp" srcset={primaryCoverSources.srcSet} sizes="(min-width: 64rem) 50vw, 100vw" />
                )}
                <img src={primaryCoverImage} alt={primaryCoverAlt} loading="eager" fetchpriority="high" decoding="async" />
              </picture>
            </a>
            <div class="featured-post__body">
              <div class="post-card__header">
                <span class="kicker">{primaryPost.data.valueType}</span>
                <span class="post-card__meta">{getReadingTime(primaryPost.body)} min read</span>
              </div>
              <h3 class="featured-post__title">
                <a href={`/blog/${primaryPost.id}/`}>{primaryPost.data.title}</a>
              </h3>
              <p>{primaryPost.data.description}</p>
              <div class="button-row">
                <a class="button" href={`/blog/${primaryPost.id}/`}>Read article</a>
              </div>
            </div>
          </article>

          <div class="featured-writing-layout__side">
            {supportingPosts.map((post) => (
              <ArticleCard post={post} filterTokens={getPostFilterTokens(post)} showTags={false} />
            ))}
          </div>
        </div>
      ) : (
        <p class="empty-state">No published articles available yet.</p>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Topics</span>
      <h2 class="section-title">Choose a production AI reading path</h2>
      <div class="topic-grid" style="margin-top: 2rem;">
        {topicPaths.map((path) => (
          <a class="topic-card topic-card--path" href={`/blog/topic/${path.topic.slug}/`}>
            <span class="topic-card__count">{path.topic.count} {path.topic.count === 1 ? 'post' : 'posts'}</span>
            <h3 class="topic-card__title">{path.title}</h3>
            <p class="topic-card__description">{path.promise}</p>
            <span class="topic-card__link">{path.cta} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight">
      <div class="container home-speaking">
        <div class="card surface">
          <span class="eyebrow">Speaking</span>
          <h2 class="section-title" style="font-size: clamp(2.2rem, 5vw, 3.2rem);">Selected talks</h2>
          <p class="section-copy">
          Conference sessions on production AI, MLOps, observability and data platform architecture.
          </p>
        <div class="button-row">
          <a class="button" href="/speaking/">View all speaking appearances</a>
        </div>
      </div>

      <div class="detail-grid">
        {featuredSpeakingSessions.map((talk) => (
          <article class="detail-card">
            <span class="kicker session-meta">
              <a href={talk.eventUrl} target="_blank" rel="noreferrer">{talk.event} {talk.year}</a>
            </span>
            <h3 class="card__title">
              <a href={talk.sessionUrl} target="_blank" rel="noreferrer">{talk.title}</a>
            </h3>
            <p>{talk.focus}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container home-utility">
      <article class="home-feature surface">
        <figure class="about-inline-photo">
          <picture>
            <source
              type="image/webp"
              srcset="/images/maciej-kepa-about-480.webp 480w, /images/maciej-kepa-about-960.webp 960w"
              sizes="(min-width: 64rem) 10.5rem, 7.5rem"
            />
            <img src={portrait} alt="Maciej Kępa" width="4000" height="6000" loading="lazy" decoding="async" />
          </picture>
        </figure>
        <div class="about-inline-content">
          <span class="eyebrow">About me</span>
          <h2 class="section-title about-inline-title">Architecture, delivery and AI systems that have to hold up in production</h2>
          <p class="section-copy">
            I am a Data & AI Architect working on production data platforms, MLOps and cloud-native AI systems. My work focuses on the engineering decisions that make these systems operable, observable and maintainable.
          </p>
          <div class="button-row">
            <a class="button" href="/about/">Read more about Maciej Kępa</a>
            <a class="button button--secondary" href="/projects/">View projects</a>
          </div>
        </div>
      </article>

      <aside class="home-feature home-feature--compact surface">
        <span class="eyebrow">RSS</span>
        <h2 class="section-title" style="font-size: clamp(1.55rem, 3.2vw, 2.05rem);">RSS feed for full posts and guides</h2>
        <p class="section-copy">
          Use the feed if you want the writing directly, without signup flow, newsletter formatting or social noise.
        </p>
        <div class="home-feature__list">
          {rssHighlights.map((item) => (
            <p>{item}</p>
          ))}
        </div>
        <div class="home-feature__meta mono">/rss.xml</div>
        <div class="button-row">
          <a class="button" href={siteConfig.links.rss}>Open RSS feed</a>
          <a class="button button--secondary" href="/blog/">Browse posts</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
