---
import BaseLayout from '../layouts/BaseLayout.astro';
import { selectedProjects } from '../lib/projects';
import { siteConfig } from '../lib/site';

const stacks = [
  {
    label: 'Microsoft Azure',
    icon: 'https://api.iconify.design/devicon/azure.svg',
    note: 'Cloud platform'
  },
  {
    label: 'Microsoft Fabric',
    icon: 'https://api.iconify.design/thesvg-color/microsoft-fabric.svg',
    note: 'Data engineering and analytics'
  },
  {
    label: 'Microsoft Foundry',
    icon: 'https://api.iconify.design/selfhst/microsoft-foundry.svg',
    iconCredit: 'Icon by selfh.st — https://github.com/selfhst/icons — CC BY 4.0 — https://creativecommons.org/licenses/by/4.0/ (unmodified)',
    note: 'AI applications and agents'
  },
  {
    label: 'Databricks',
    icon: 'https://cdn.simpleicons.org/databricks/EA4335',
    note: 'Lakehouse and orchestration'
  },
  {
    label: 'Python',
    icon: 'https://cdn.simpleicons.org/python/3776AB',
    note: 'Automation and platform code'
  },
  {
    label: 'PySpark',
    icon: 'https://cdn.simpleicons.org/apachespark/E25A1C',
    note: 'Data processing'
  },
  {
    label: 'SQL Server',
    icon: 'https://api.iconify.design/devicon/microsoftsqlserver.svg',
    note: 'Data modeling and query work'
  },
  {
    label: 'MLflow',
    icon: 'https://cdn.simpleicons.org/mlflow/0194E2',
    note: 'Experiment and model lifecycle'
  },
  {
    label: 'GitHub Actions',
    icon: 'https://cdn.simpleicons.org/githubactions/2088FF',
    note: 'CI/CD workflows'
  },
  {
    label: 'Terraform',
    icon: 'https://cdn.simpleicons.org/terraform/844FBA',
    note: 'Infrastructure automation'
  },
  {
    label: 'Docker',
    icon: 'https://cdn.simpleicons.org/docker/2496ED',
    note: 'Containers and portable runtime environments'
  }
];
---

<BaseLayout seoTitle="MLOps & AI Projects - Maciej Kępa" description="Explore Maciej Kępa’s MCP server and AI/ML workshop materials: runnable examples, architecture decisions, setup instructions and practical limitations.">
  <section class="section">
    <div class="container">
      <span class="eyebrow">Selected work</span>
      <h1 class="section-title">Code and workshops behind the writing</h1>
      <p class="section-copy">Public examples you can inspect and run, with the design decisions and limits made explicit.</p>
    </div>
  </section>

  {selectedProjects.map((project) => (
    <section class="section section--tight" id={project.id}>
      <div class="container about-section surface">
        <div class="about-section__intro">
          <span class="eyebrow">{project.kind}</span>
          <h2 class="section-title section-title--compact">{project.title}</h2>
          <p class="section-copy">{project.summary}</p>
          <div class="button-row">
            <a class="button" href={project.repoUrl}>View repository</a>
            <a class="button button--secondary" href={project.startUrl}>{project.startLabel}</a>
          </div>
        </div>
        <div class="about-section__body about-entry-list">
          <div class="about-entry"><h3 class="card__title">The idea behind it</h3><p>{project.decision}</p></div>
          <div class="about-entry"><h3 class="card__title">What you can run</h3><p>{project.start}</p></div>
          <div class="about-entry"><h3 class="card__title">Scope and limits</h3><p>{project.limits}</p></div>
          <nav class="resource-links" aria-label={`${project.title} materials`}>
            {project.links.map((link) => <a href={link.href}>{link.label} →</a>)}
          </nav>
        </div>
      </div>
    </section>
  ))}

  <section class="section section--tight">
    <div class="container about-section surface">
      <div class="about-section__intro">
        <span class="eyebrow">Working stack</span>
        <h2 class="section-title" style="font-size: clamp(2rem, 4vw, 2.9rem);">Core technologies behind the work</h2>
        <p class="section-copy">The stack is deliberately practical: cloud platform, lakehouse, orchestration, automation and writing tools that support repeatable delivery.</p>
      </div>

      <div class="about-section__body tech-grid">
        {stacks.map((stack) => (
          <article class="tech-tile">
            <span class="tech-tile__icon">
              <img src={stack.icon} alt={`${stack.label} logo`} title={stack.iconCredit} loading="lazy" />
            </span>
            <div>
              <h3 class="card__title">{stack.label}</h3>
              <p>{stack.note}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container home-feature surface">
      <span class="eyebrow">GitHub</span>
      <h2 class="section-title" style="font-size: clamp(2rem, 4vw, 2.8rem);">All projects live on GitHub</h2>
      <p class="section-copy">
        Repositories, experiments, demos and supporting code are all available on GitHub.
      </p>
      <div class="button-row">
        <a class="button" href={siteConfig.links.github} target="_blank" rel="noreferrer">Open GitHub profile</a>
      </div>
    </div>
  </section>
</BaseLayout>
